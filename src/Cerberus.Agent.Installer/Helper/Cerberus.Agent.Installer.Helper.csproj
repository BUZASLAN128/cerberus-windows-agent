<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Cerberus.Agent.Installer.Helper</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(AgentBuildProfile)' != 'server'">true</IncludeNativeLibrariesForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(AgentBuildProfile)' == 'server'">false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(AgentBuildProfile)' == 'server'">true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentReleaseChannel</_Parameter1>
      <_Parameter2>$(AgentReleaseChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateAllowedSignerKeyIdentity</_Parameter1>
      <_Parameter2>$(AgentUpdateAllowedSignerKeyIdentity)</_Parameter2>
    </AssemblyAttribute>
    <ProjectReference Include="..\..\Cerberus.Agent.Core\Cerberus.Agent.Core.csproj" />
    <ProjectReference Include="..\..\Cerberus.Agent.Security\Cerberus.Agent.Security.csproj" />
    <Compile Include="..\..\Cerberus.Agent.App\Updates\AgentUpdateLabPolicy.cs" Link="AgentUpdateLabPolicy.cs" />
    <Compile Include="..\..\Cerberus.Agent.App\Updates\AgentUpdateLabRuntimeAdmission.cs" Link="AgentUpdateLabRuntimeAdmission.cs" />
  </ItemGroup>
</Project>
