<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Cerberus Windows Agent"
      Manufacturer="Cerberus"
      Version="$(var.MsiProductVersion)"
      UpgradeCode="{8F7E4C22-4D3E-4D50-9B31-0D969B3D0D1E}"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Cerberus Windows Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)Assets\EULA.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <Feature Id="MainFeature" Title="Cerberus Windows Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="LegalConsentRegistryComponent" />
    </Feature>

    <CustomAction
        Id="LaunchAgentTray"
        Directory="INSTALLFOLDER"
        ExeCommand='"[INSTALLFOLDER]Cerberus.Agent.App.exe" --tray'
        Execute="immediate"
        Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchAgentTray" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CompanyFolder" Name="Cerberus">
        <Directory Id="INSTALLFOLDER" Name="Windows Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Cerberus" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExecutableComponent" Guid="{7C6D5F34-379E-4B19-9BC3-4F840E07C765}">
        <File Id="AgentExe" Source="$(var.AgentPublishDir)\Cerberus.Agent.App.exe" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveCompanyFolder" Directory="CompanyFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent" Name="agentExeInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="LegalConsentRegistryComponent" Directory="INSTALLFOLDER" Guid="{6FD72DD1-B76B-4E07-94A2-4355A5FB403D}">
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="accepted" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="product" Type="string" Value="Cerberus Windows Agent" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="eulaVersion" Type="string" Value="$(var.EulaVersion)" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="privacyNoticeVersion" Type="string" Value="$(var.PrivacyNoticeVersion)" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="securityDisclosureVersion" Type="string" Value="$(var.SecurityDisclosureVersion)" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="acceptedVia" Type="string" Value="msi_eula_dialog" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="{E34F58AE-32F5-47E1-B41A-B8470C84587A}">
      <Shortcut
          Id="StartMenuShortcut"
          Name="Cerberus Agent Setup"
          Description="Open Cerberus Windows Agent setup"
          Target="[INSTALLFOLDER]Cerberus.Agent.App.exe"
          Arguments="--tray"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
