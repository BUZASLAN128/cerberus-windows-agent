<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Cerberus Windows Agent"
      Manufacturer="Cerberus"
      Version="$(var.MsiProductVersion)"
      UpgradeCode="{8F7E4C22-4D3E-4D50-9B31-0D969B3D0D1E}"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade
        Schedule="afterInstallExecute"
        DowngradeErrorMessage="A newer version of Cerberus Windows Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_ACCEPT_LICENSE_AGREEMENT" Secure="yes" />
    <Property Id="CERBERUS_EULA_ACCEPTED" Secure="yes" />
    <Property Id="CERBERUS_BACKEND_URL" Secure="yes" />
    <Property Id="CERBERUS_SSO_BASE_URL" Secure="yes" />
    <Property Id="CERBERUS_SSO_CLIENT_ID" Secure="yes" />
    <Property Id="CERBERUS_SSO_SCOPE" Value="openid profile email groups" Secure="yes" />
    <Property Id="CERBERUS_CHANNEL" Value="$(var.ReleaseChannel)" Secure="yes" />
    <Property Id="CERBERUS_LANGUAGE" Value="auto" Secure="yes" />
    <Property Id="CERBERUS_AGENT_UPDATE_MANIFEST_URL" Value="$(var.UpdateManifestUrl)" Secure="yes" />
    <Property Id="CERBERUS_AGENT_UPDATE_MANIFEST_PUBLIC_KEY_B64" Value="$(var.UpdateManifestPublicKeyB64)" Secure="yes" />
    <Property Id="CERBERUS_AGENT_UPDATE_ALLOWED_ARTIFACT_PREFIXES" Value="$(var.UpdateAllowedArtifactPrefixes)" Secure="yes" />
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="0" Secure="yes" />
    <Property Id="START_TRAY_ON_LOGIN" Value="1" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)Assets\EULA.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <Icon Id="CerberusAgentIcon" SourceFile="$(var.ProjectDir)..\Assets\cerberus-app.ico" />
    <Property Id="ARPPRODUCTICON" Value="CerberusAgentIcon" />
    <util:CloseApplication
        Id="CloseRunningAgentUi"
        Target="Cerberus.Agent.exe"
        CloseMessage="yes"
        ElevatedCloseMessage="yes"
        TerminateProcess="1"
        RebootPrompt="no"
        Timeout="15" />
    <util:CloseApplication
        Id="CloseLegacyAgentApp"
        Target="Cerberus.Agent.App.exe"
        CloseMessage="yes"
        ElevatedCloseMessage="yes"
        TerminateProcess="1"
        RebootPrompt="no"
        Timeout="15" />
    <util:CloseApplication
        Id="CloseRunningAgentTray"
        Target="Cerberus.Agent.Tray.exe"
        CloseMessage="yes"
        ElevatedCloseMessage="yes"
        TerminateProcess="1"
        RebootPrompt="no"
        Timeout="15" />
    <util:CloseApplication
        Id="CloseRunningAgentSetup"
        Target="Cerberus.Agent.Setup.exe"
        CloseMessage="yes"
        ElevatedCloseMessage="yes"
        TerminateProcess="1"
        RebootPrompt="no"
        Timeout="15" />

    <Feature Id="MainFeature" Title="Cerberus Windows Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopAgentShortcutComponent" />
      <ComponentRef Id="StartupShortcutComponent" />
      <ComponentRef Id="LegalConsentRegistryComponent" />
    </Feature>

    <CustomAction
        Id="LaunchAgentUi"
        Directory="INSTALLFOLDER"
        ExeCommand='"[INSTALLFOLDER]Cerberus.Agent.exe" --open'
        Execute="immediate"
        Return="asyncNoWait" />
    <CustomAction
        Id="BlockInstallWithoutEula"
        Error="Cerberus Windows Agent setup requires accepting the EULA. Use the installer UI, or pass CERBERUS_EULA_ACCEPTED=1 for approved managed deployment." />
    <CustomAction
        Id="RepairExistingCerberusServicePath"
        Directory="INSTALLFOLDER"
        ExeCommand='&quot;[SystemFolder]sc.exe&quot; config CerberusAgent binPath= &quot;\&quot;[INSTALLFOLDER]Cerberus.Agent.Service.exe\&quot;&quot; start= auto'
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="StartExistingCerberusServiceAfterRepair"
        Directory="INSTALLFOLDER"
        ExeCommand='&quot;[SystemFolder]sc.exe&quot; start CerberusAgent'
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="RemoveLegacyUserStartupShortcut"
        Directory="INSTALLFOLDER"
        ExeCommand='&quot;[SystemFolder]cmd.exe&quot; /c del /f /q &quot;%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\Cerberus Agent Tray.lnk&quot;'
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_X64" After="InstallInitialize" Condition="NOT REMOVE" />
      <Custom
          Action="BlockInstallWithoutEula"
          Before="InstallValidate"
          Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE AND UILevel &lt; 5 AND NOT CERBERUS_EULA_ACCEPTED = 1" />
      <Custom Action="RepairExistingCerberusServicePath" After="RemoveExistingProducts" Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED" />
      <Custom Action="StartExistingCerberusServiceAfterRepair" After="RepairExistingCerberusServicePath" Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED" />
      <Custom Action="RemoveLegacyUserStartupShortcut" After="StartExistingCerberusServiceAfterRepair" Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED" />
      <Custom Action="LaunchAgentUi" After="InstallFinalize" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="Cerberus">
        <Directory Id="INSTALLFOLDER" Name="Windows Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Cerberus" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.AgentPublishDir)\**">
        <Exclude Files="$(var.AgentPublishDir)\**\*.pdb" />
        <Exclude Files="$(var.AgentPublishDir)\**\*.wixpdb" />
      </Files>
      <Component Id="AgentInstallRegistryComponent" Guid="{7C6D5F34-379E-4B19-9BC3-4F840E07C765}">
        <ServiceControl
            Id="ControlExistingCerberusAgentService"
            Name="CerberusAgent"
            Stop="both"
            Wait="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveCompanyFolder" Directory="CompanyFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="agentExeInstalled" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="installRoot" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="ProductCode" Type="string" Value="[ProductCode]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="productVersion" Type="string" Value="$(var.ReleaseVersion)" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="updateChannel" Type="string" Value="[CERBERUS_CHANNEL]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="backendUrl" Type="string" Value="[CERBERUS_BACKEND_URL]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="ssoBaseUrl" Type="string" Value="[CERBERUS_SSO_BASE_URL]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="ssoClientId" Type="string" Value="[CERBERUS_SSO_CLIENT_ID]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="ssoScope" Type="string" Value="[CERBERUS_SSO_SCOPE]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="language" Type="string" Value="[CERBERUS_LANGUAGE]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="updateManifestUrl" Type="string" Value="[CERBERUS_AGENT_UPDATE_MANIFEST_URL]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="updateManifestPublicKeyB64" Type="string" Value="[CERBERUS_AGENT_UPDATE_MANIFEST_PUBLIC_KEY_B64]" />
        <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent" Name="updateAllowedArtifactPrefixes" Type="string" Value="[CERBERUS_AGENT_UPDATE_ALLOWED_ARTIFACT_PREFIXES]" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="LegalConsentRegistryComponent" Directory="INSTALLFOLDER" Guid="{6FD72DD1-B76B-4E07-94A2-4355A5FB403D}">
      <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="accepted" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="product" Type="string" Value="Cerberus Windows Agent" />
      <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="eulaVersion" Type="string" Value="$(var.EulaVersion)" />
      <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="privacyNoticeVersion" Type="string" Value="$(var.PrivacyNoticeVersion)" />
      <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="securityDisclosureVersion" Type="string" Value="$(var.SecurityDisclosureVersion)" />
      <RegistryValue Root="HKLM" Key="Software\Cerberus\WindowsAgent\LegalConsent" Name="acceptedVia" Type="string" Value="msi_eula_dialog" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="{E34F58AE-32F5-47E1-B41A-B8470C84587A}">
      <Shortcut
          Id="StartMenuAgentShortcut"
          Name="Cerberus Agent"
          Description="Open Cerberus Agent"
          Target="[INSTALLFOLDER]Cerberus.Agent.exe"
          Arguments="--open"
          WorkingDirectory="INSTALLFOLDER" />
      <Shortcut
          Id="StartMenuUninstallShortcut"
          Name="Uninstall Cerberus Agent"
          Description="Remove Cerberus Windows Agent"
          Target="[INSTALLFOLDER]Cerberus.Agent.Uninstall.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="StartupFolder" />
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <Component Id="StartupShortcutComponent" Directory="StartupFolder" Guid="{C5883153-5082-4373-9825-A9FDE199B234}" Condition="START_TRAY_ON_LOGIN = 1">
      <Shortcut
          Id="StartupShortcut"
          Name="Cerberus Agent"
          Description="Start Cerberus Agent at sign-in"
          Target="[INSTALLFOLDER]Cerberus.Agent.exe"
          Arguments="--background"
          WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent" Name="trayAutostart" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopAgentShortcutComponent" Directory="DesktopFolder" Guid="{B1D4CF86-4B6F-4C6E-B75C-7A5D2C924EA9}" Condition="CREATE_DESKTOP_SHORTCUT = 1">
      <Shortcut
          Id="DesktopAgentShortcut"
          Name="Cerberus Agent"
          Description="Open Cerberus Agent"
          Target="[INSTALLFOLDER]Cerberus.Agent.exe"
          Arguments="--open"
          WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Cerberus\WindowsAgent" Name="desktopAgentShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
