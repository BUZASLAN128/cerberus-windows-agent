<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(var.AgentBuildProfile) = server ?>
  <?define ProxyRegistryPath = "Software\Cerberus\ServerAgent\Network" ?>
  <?define ProxyComponentGuid = "{708FE021-30A7-4E4A-A096-390EE585AD67}" ?>
  <?else ?>
  <?define ProxyRegistryPath = "Software\Cerberus\WindowsAgent\Network" ?>
  <?define ProxyComponentGuid = "{09E0BD13-78DB-46A7-A388-9A5FB62222E2}" ?>
  <?endif ?>
  <Fragment>
    <!-- Hidden=yes includes both proxy values in the compiled MsiHiddenProperties list. -->
    <Property Id="CERBERUS_PROXY_URL" Secure="yes" Hidden="yes" />
    <Property Id="AgentProxyForbiddenQuote" Value="&quot;" />
    <Property Id="CERBERUS_EXISTING_PROXY_URL" Secure="yes" Hidden="yes">
      <RegistrySearch Id="ExistingAgentProxyUrl" Root="HKLM" Key="$(var.ProxyRegistryPath)"
                      Name="proxyUrl" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="CERBERUS_PROXY_URL" Value="[CERBERUS_EXISTING_PROXY_URL]"
                 Before="CostFinalize" Sequence="both"
                 Condition="NOT CERBERUS_PROXY_URL AND CERBERUS_EXISTING_PROXY_URL" />
    <!-- The existing SYSTEM-only helper gate is retained; validate before any registry value is written. -->
    <CustomAction Id="RejectQuotedAgentProxyUrl" Error="Proxy URL must not contain quotation marks." />
    <CustomAction Id="ValidateAgentProxyUrl" BinaryRef="CerberusInstallerHelper"
                  ExeCommand='validate-proxy "[ProductCode]" "[CERBERUS_PROXY_URL]" "" "" ""'
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="RejectQuotedAgentProxyUrl" Before="InstallInitialize"
              Condition="NOT REMOVE AND (CERBERUS_PROXY_URL &gt;&lt; AgentProxyForbiddenQuote)" />
      <Custom Action="ValidateAgentProxyUrl" Before="WriteRegistryValues" Condition="NOT REMOVE AND CERBERUS_PROXY_URL" />
    </InstallExecuteSequence>
    <ComponentGroup Id="AgentProxyConfiguration">
      <Component Id="AgentProxyRegistry" Directory="INSTALLFOLDER" Guid="$(var.ProxyComponentGuid)" Bitness="always64"
                 Condition="CERBERUS_PROXY_URL">
        <RegistryKey Root="HKLM" Key="$(var.ProxyRegistryPath)">
          <RegistryValue Name="proxyUrl" Type="string" Value="[CERBERUS_PROXY_URL]" KeyPath="yes" />
          <PermissionEx Sddl="O:SYG:SYD:P(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;KR;;;BU)" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
