<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(var.AgentBuildProfile) = server ?>
  <Fragment>
    <Upgrade Id="{686EF4F7-AC5C-4459-B2B9-540920991AAF}">
      <UpgradeVersion Minimum="$(var.MsiProductVersion)" IncludeMinimum="no" OnlyDetect="yes" Property="CERBERUS_NEWER_DETECTED" />
    </Upgrade>
    <Property Id="CERBERUS_NEWER_DETECTED" Secure="yes" />
    <Property Id="CERBERUS_ROLLBACK_ATTEMPT" Secure="yes" />
    <!-- Keep the formatted action template within the MSI CustomAction.Target column width. -->
    <Property Id="RollbackServiceExeSha256" Value="$(var.ServiceExeSha256)" />
    <Property Id="RollbackServiceAssemblySha256" Value="$(var.ServiceAssemblySha256)" />
    <CustomAction Id="BlockNewServerDowngradeWithRemoval" Error="An older Cerberus Server Agent cannot be installed with a feature-removal request." />
    <CustomAction Id="RequireRollbackGrant" BinaryRef="CerberusInstallerHelper"
        ExeCommand='require-rollback-grant "[ProductCode]" "[APPFOLDER]." "$(var.ReleaseVersion)" "[RollbackServiceExeSha256]" "[RollbackServiceAssemblySha256]" "[CERBERUS_NEWER_DETECTED]" "[CERBERUS_ROLLBACK_ATTEMPT]" "[OriginalDatabase]"'
        Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="BlockServerInstallWithoutRollback" Error="Cerberus Server Agent requires Windows Installer rollback to be enabled." />
    <CustomAction Id="LkgBootstrap" BinaryRef="CerberusInstallerHelper"
        ExeCommand='lkg-bootstrap "[ProductCode]" "[APPFOLDER]." "$(var.ReleaseVersion)" "[RollbackServiceExeSha256]" "[RollbackServiceAssemblySha256]"'
        Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="ReregisterWatchTask" BinaryRef="CerberusInstallerHelper"
        ExeCommand='reregister-watch-task "[ProductCode]" "[APPFOLDER]." "$(var.ReleaseVersion)" "[RollbackServiceExeSha256]" "[RollbackServiceAssemblySha256]"'
        Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="UnregisterWatchTask" BinaryRef="CerberusInstallerHelper"
        ExeCommand='unregister-watch-task "[ProductCode]" "[APPFOLDER]." "$(var.ReleaseVersion)" "[RollbackServiceExeSha256]" "[RollbackServiceAssemblySha256]"'
        Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="BlockNewServerDowngradeWithRemoval" Before="InstallInitialize" Condition="CERBERUS_NEWER_DETECTED AND REMOVE AND NOT Installed" />
      <Custom Action="BlockServerInstallWithoutRollback" Before="InstallInitialize" Condition="NOT REMOVE AND RollbackDisabled" />
      <Custom Action="RequireRollbackGrant" After="InstallInitialize" Condition="CERBERUS_NEWER_DETECTED AND NOT REMOVE" />
      <Custom Action="LkgBootstrap" After="CommitLabCampaignAdmission" Condition="NOT REMOVE" />
      <Custom Action="ReregisterWatchTask" Before="UnregisterWatchTask" Condition='REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="UnregisterWatchTask" Before="RemoveFiles" Condition='REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>
  </Fragment>
  <?endif ?>
</Wix>
