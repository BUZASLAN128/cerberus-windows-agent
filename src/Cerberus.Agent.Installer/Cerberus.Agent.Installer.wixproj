<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <MsiProductVersion Condition="'$(MsiProductVersion)' == ''">$(Version)</MsiProductVersion>
    <Channel Condition="'$(Channel)' == ''">preview</Channel>
    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\public-release\publish</AgentPublishDir>
    <InstallerHelperPath Condition="'$(InstallerHelperPath)' == ''">$(MSBuildThisFileDirectory)Helper\bin\$(Configuration)\net8.0-windows\win-x64\publish\Cerberus.Agent.Installer.Helper.exe</InstallerHelperPath>
    <InstallerAssetBase Condition="'$(InstallerAssetBase)' == ''">Cerberus.Agent-$(Channel)-$(Version)</InstallerAssetBase>
    <UpdateManifestUrl Condition="'$(UpdateManifestUrl)' == '' and '$(Channel)' == 'stable'">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/latest/download/Cerberus.Agent.Bundle-stable-latest.update-manifest.v2.json</UpdateManifestUrl>
    <UpdateManifestUrl Condition="'$(UpdateManifestUrl)' == '' and '$(Channel)' != 'stable'">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/$(Channel)-latest/Cerberus.Agent.Bundle-$(Channel)-latest.update-manifest.v2.json</UpdateManifestUrl>
    <UpdateManifestPublicKeyB64 Condition="'$(UpdateManifestPublicKeyB64)' == ''">IA==</UpdateManifestPublicKeyB64>
    <UpdateAllowedArtifactPrefixes Condition="'$(UpdateAllowedArtifactPrefixes)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/</UpdateAllowedArtifactPrefixes>
    <OutputName>$(InstallerAssetBase)</OutputName>
    <SuppressIces>ICE91</SuppressIces>
    <SuppressIces Condition="'$(Channel)' == 'dev'">$(SuppressIces);ICE61</SuppressIces>
    <DefineConstants>
      AgentPublishDir=$(AgentPublishDir);
      InstallerHelperPath=$(InstallerHelperPath);
      ServiceExeSha256=$(ServiceExeSha256);
      ServiceAssemblySha256=$(ServiceAssemblySha256);
      ReleaseVersion=$(Version);
      MsiProductVersion=$(MsiProductVersion);
      ReleaseChannel=$(Channel);
      UpdateManifestUrl=$(UpdateManifestUrl);
      UpdateManifestPublicKeyB64=$(UpdateManifestPublicKeyB64);
      UpdateAllowedArtifactPrefixes=$(UpdateAllowedArtifactPrefixes);
      EulaVersion=agent-eula-2026-06-02.v2;
      PrivacyNoticeVersion=agent-privacy-2026-06-02.v2;
      SecurityDisclosureVersion=agent-security-2026-05-23.v1
    </DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateUpdateHealthInputs" BeforeTargets="Build">
    <Error Condition="!Exists('$(InstallerHelperPath)')" Text="Published installer transaction helper is required." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ServiceExeSha256)', '^[a-fA-F0-9]{64}$'))" Text="Exact service executable SHA256 is required." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ServiceAssemblySha256)', '^[a-fA-F0-9]{64}$'))" Text="Exact service assembly SHA256 is required." />
  </Target>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
