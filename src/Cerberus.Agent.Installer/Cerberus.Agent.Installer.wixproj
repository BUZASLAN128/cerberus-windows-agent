<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <MsiProductVersion Condition="'$(MsiProductVersion)' == ''">$(Version)</MsiProductVersion>
    <Channel Condition="'$(Channel)' == ''">preview</Channel>
    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\public-release\publish</AgentPublishDir>
    <InstallerAssetBase Condition="'$(InstallerAssetBase)' == ''">Cerberus.Agent-$(Channel)-$(Version)</InstallerAssetBase>
    <UpdateManifestUrl Condition="'$(UpdateManifestUrl)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/$(Channel)-latest/Cerberus.Agent.Bundle-$(Channel)-latest.update-manifest.json</UpdateManifestUrl>
    <UpdateManifestPublicKeyB64 Condition="'$(UpdateManifestPublicKeyB64)' == ''">IA==</UpdateManifestPublicKeyB64>
    <UpdateAllowedArtifactPrefixes Condition="'$(UpdateAllowedArtifactPrefixes)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/</UpdateAllowedArtifactPrefixes>
    <OutputName>$(InstallerAssetBase)</OutputName>
    <SuppressIces>ICE91</SuppressIces>
    <SuppressIces Condition="'$(Channel)' == 'dev'">$(SuppressIces);ICE61</SuppressIces>
    <DefineConstants>
      AgentPublishDir=$(AgentPublishDir);
      ReleaseVersion=$(Version);
      MsiProductVersion=$(MsiProductVersion);
      ReleaseChannel=$(Channel);
      UpdateManifestUrl=$(UpdateManifestUrl);
      UpdateManifestPublicKeyB64=$(UpdateManifestPublicKeyB64);
      UpdateAllowedArtifactPrefixes=$(UpdateAllowedArtifactPrefixes);
      EulaVersion=agent-eula-2026-05-23.v1;
      PrivacyNoticeVersion=agent-privacy-2026-05-23.v1;
      SecurityDisclosureVersion=agent-security-2026-05-23.v1
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
