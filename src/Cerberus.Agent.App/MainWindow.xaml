<Window x:Class="Cerberus.Agent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cerberus.Agent.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Cerberus Agent" Height="560" Width="440"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFFFFFFF"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CerberusButtonBase" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF111827" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CerberusButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource CerberusButtonBase}">
            <Setter Property="Background" Value="#FF111827" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF111827" />
        </Style>

        <Style x:Key="CerberusTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF111827" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="#FF111827" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="#FF111827" Text="Cerberus Agent" />
                <TextBlock Name="SubtitleText" Margin="0,4,0,0" Foreground="#FF6B7280" Text="Connect this device to your workspace" />
            </StackPanel>

            <Button Grid.Column="1" Width="28" Height="28" Click="Close_Click"
                    Style="{StaticResource CerberusButtonBase}"
                    Padding="0" Content="×" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Name="ServiceLabel" Foreground="#FF6B7280" FontSize="11" Text="Service" />
                        <TextBlock Name="ServiceValue" Foreground="#FF111827" FontWeight="SemiBold" Text="-" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Name="TailscaleLabel" Foreground="#FF6B7280" FontSize="11" Text="Tailscale" />
                        <TextBlock Name="TailscaleValue" Foreground="#FF111827" FontWeight="SemiBold" Text="-" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Name="RegisteredLabel" Foreground="#FF6B7280" FontSize="11" Text="Registered" />
                        <TextBlock Name="RegisteredValue" Foreground="#FF111827" FontWeight="SemiBold" Text="-" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="10" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Name="LocalUserCreateLabel" Foreground="#FF6B7280" FontSize="11" Text="User create" />
                        <TextBlock Name="LocalUserCreateValue" Foreground="#FF111827" FontWeight="SemiBold" Text="-" />
                        <Button Name="LocalUserCreateToggleBtn" Margin="0,6,0,0" Height="24" Padding="6,2"
                                FontSize="11" Click="LocalUserCreateToggle_Click"
                                Style="{StaticResource CerberusButtonBase}">Enable</Button>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Name="ReadinessPanel" CornerRadius="14" Background="#FFF0FDF4" BorderBrush="#FFBBF7D0" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Name="ReadinessValue" Foreground="#FF14532D" FontSize="16" FontWeight="SemiBold" Text="Checking setup..." />
                    <TextBlock Name="ReadinessDetail" Margin="0,6,0,0" Foreground="#FF166534" TextWrapping="Wrap"
                               Text="Cerberus is checking registration and Windows service status." />
                </StackPanel>
            </Border>

            <Border CornerRadius="14" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Name="DeviceSetupLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Device setup" />
                    <TextBlock Name="DeviceSetupDetail" Margin="0,6,0,0" Foreground="#FF6B7280"
                               Text="Accept the terms, sign in, and let Cerberus register this device and start the Windows service." />
                    <Button Name="OnboardBtn" Margin="0,12,0,0" Height="42" Click="Onboard_Click"
                            Style="{StaticResource CerberusButtonPrimary}">
                        Connect this device
                    </Button>
                    <TextBlock Name="OnboardHint" Margin="0,8,0,0" Foreground="#FF6B7280" FontSize="11" Text="-" />
                </StackPanel>
            </Border>

            <Expander Name="AdvancedRepairExpander" Margin="0,14,0,0" Header="Advanced repair tools" Foreground="#FF374151">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="14" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Name="ServiceRepairLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Service" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Name="InstallSvcBtn" Height="34" Click="InstallSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}" Margin="0,0,8,8">Install</Button>
                            <Button Name="UninstallSvcBtn" Height="34" Click="UninstallSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}" Margin="0,0,0,8">Remove service</Button>
                            <Button Name="StartSvcBtn" Height="34" Click="StartSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}" Margin="0,0,8,0">Start</Button>
                            <Button Name="StopSvcBtn" Height="34" Click="StopSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}">Stop</Button>
                        </UniformGrid>
                        <TextBlock Name="ServiceRemovalNote" Margin="0,10,0,0" Foreground="#FF6B7280" FontSize="11"
                                   Text="Removing the service keeps this device registered. Device reset is separate." />
                        <Button Name="UnregisterDeviceBtn" Margin="0,10,0,0" Height="34" Click="UnregisterDevice_Click"
                                Style="{StaticResource CerberusButtonBase}">Unregister device</Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="14" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Name="TailscaleRepairLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Tailscale" />
                        <Button Name="ExportTsBtn" Margin="0,10,0,0" Height="34" Click="ExportTs_Click"
                                Style="{StaticResource CerberusButtonBase}">Export tailscale up cmd</Button>
                        <Button Name="InstallTsBtn" Margin="0,8,0,0" Height="34" Click="InstallTs_Click"
                                Style="{StaticResource CerberusButtonBase}">Install Tailscale</Button>
                        <TextBlock Name="TsCmdPathLabel" Margin="0,10,0,0" Foreground="#FF6B7280" FontSize="11" Text="-" />
                        <TextBlock Name="TailscaleUnavailableNote" Margin="0,10,0,0" Foreground="#FF6B7280" FontSize="11"
                                   Text="If your tenant is not configured for Tailscale, export will be unavailable." />
                    </StackPanel>
                </Border>
            </Grid>
            </Expander>

            <Border CornerRadius="14" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="12" Margin="0,14,0,0">
                <TextBox Name="StatusText" Background="#FFF9FAFB" Foreground="#FF111827" BorderThickness="0"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="90" />
            </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Name="AfterSetupNote" Grid.Row="2" Margin="0,14,0,0" Foreground="#FF6B7280"
                   Text="Cerberus keeps running from the Windows tray." />
    </Grid>
</Window>
