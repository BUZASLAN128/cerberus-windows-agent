<Window x:Class="Cerberus.Agent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cerberus.Agent.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Cerberus Agent" Height="560" Width="440"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFFFFFFF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CerberusButtonBase" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF111827" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CerberusButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource CerberusButtonBase}">
            <Setter Property="Background" Value="#FF111827" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF111827" />
        </Style>

        <Style x:Key="CerberusTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF111827" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="#FF111827" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Width="178"
                   Height="40"
                   HorizontalAlignment="Left"
                   Source="pack://application:,,,/Assets/cerberus-logo.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />

            <Button Grid.Column="1" Width="28" Height="28" Click="Close_Click"
                    Style="{StaticResource CerberusButtonBase}"
                    Padding="0" Content="×" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Border CornerRadius="12" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Name="LocalUserCreateLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Account creation" />
                            <TextBlock Text=": " Foreground="#FF111827" FontWeight="SemiBold" />
                            <TextBlock Name="LocalUserCreateValue" Foreground="#FF92400E" FontWeight="SemiBold" Text="-" />
                        </StackPanel>
                        <TextBlock Name="LocalUserCreateHint" Margin="0,5,10,0" Foreground="#FF6B7280" FontSize="11"
                                   TextWrapping="Wrap" Text="Disabled by default. Backend policy must also allow account creation." />
                    </StackPanel>
                    <Button Name="LocalUserCreateToggleBtn" Grid.Column="1" Width="58" Height="28" Padding="8,0"
                            VerticalAlignment="Top" Click="LocalUserCreateToggle_Click"
                            Style="{StaticResource CerberusButtonBase}">Enable</Button>
                </Grid>
            </Border>

            <Border Name="ReadinessPanel" CornerRadius="12" Background="#FFF0FDF4" BorderBrush="#FFBBF7D0" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Name="ReadinessValue" Foreground="#FF14532D" FontSize="16" FontWeight="SemiBold" Text="Checking setup..." />
                    <TextBlock Name="ReadinessDetail" Margin="0,6,0,0" Foreground="#FF166534" TextWrapping="Wrap"
                               Text="Cerberus is checking registration and Windows service status." />
                    <TextBlock Name="ReadinessHint" Margin="0,8,0,0" Foreground="#FF166534" FontSize="11" TextWrapping="Wrap" Text="-" />
                </StackPanel>
            </Border>

            <Border Name="DeviceSetupCard" CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Name="DeviceSetupLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Device setup" />
                    <TextBlock Name="DeviceSetupDetail" Margin="0,6,0,0" Foreground="#FF6B7280" TextWrapping="Wrap"
                               Text="Accept the terms, sign in, and let Cerberus register this device and start the Windows service." />
                    <Button Name="OnboardBtn" Margin="0,12,0,0" Width="156" Height="34" HorizontalAlignment="Right" Click="Onboard_Click"
                            Style="{StaticResource CerberusButtonPrimary}">
                        Connect this device
                    </Button>
                    <TextBlock Name="OnboardHint" Margin="0,8,0,0" Foreground="#FF6B7280" FontSize="11" TextWrapping="Wrap" Text="-" />
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Name="SystemInfoLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="System information" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Name="ServiceInfoLabel" Grid.Row="0" Foreground="#FF64748B" FontSize="12" Text="Service status" />
                        <TextBlock Name="ServiceInfoValue" Grid.Row="0" Grid.Column="1" Foreground="#FF0F766E" FontSize="12" FontWeight="SemiBold" Text="-" />

                        <TextBlock Name="ConnectorInfoLabel" Grid.Row="1" Margin="0,9,0,0" Foreground="#FF64748B" FontSize="12" Text="Network connection" />
                        <TextBlock Name="ConnectorInfoValue" Grid.Row="1" Grid.Column="1" Margin="18,9,0,0" Foreground="#FF0F766E" FontSize="12" FontWeight="SemiBold" Text="-" />

                        <TextBlock Name="RegisteredInfoLabel" Grid.Row="2" Margin="0,9,0,0" Foreground="#FF64748B" FontSize="12" Text="Registration" />
                        <TextBlock Name="RegisteredInfoValue" Grid.Row="2" Grid.Column="1" Margin="18,9,0,0" Foreground="#FF0F766E" FontSize="12" FontWeight="SemiBold" Text="-" />

                        <TextBlock Name="VersionInfoLabel" Grid.Row="3" Margin="0,9,0,0" Foreground="#FF64748B" FontSize="12" Text="Agent version" />
                        <TextBlock Name="VersionInfoValue" Grid.Row="3" Grid.Column="1" Margin="18,9,0,0" Foreground="#FF334155" FontSize="12" FontWeight="SemiBold" Text="-" />

                        <TextBlock Name="LastRefreshInfoLabel" Grid.Row="4" Margin="0,9,0,0" Foreground="#FF64748B" FontSize="12" Text="Last check" />
                        <TextBlock Name="LastRefreshInfoValue" Grid.Row="4" Grid.Column="1" Margin="18,9,0,0" Foreground="#FF334155" FontSize="12" FontWeight="SemiBold" Text="-" />
                    </Grid>
                </StackPanel>
            </Border>

            <Expander Name="AdvancedRepairExpander" Margin="0,4,0,0" Header="Advanced repair tools" Foreground="#FF374151">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="14" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Name="ServiceRepairLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Service" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Name="InstallSvcBtn" Height="34" Click="InstallSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}" Margin="0,0,8,8">Install</Button>
                            <Button Name="UninstallSvcBtn" Height="34" Click="UninstallSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}" Margin="0,0,0,8">Remove service</Button>
                            <Button Name="StartSvcBtn" Height="34" Click="StartSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}" Margin="0,0,8,0">Start</Button>
                            <Button Name="StopSvcBtn" Height="34" Click="StopSvc_Click"
                                    Style="{StaticResource CerberusButtonBase}">Stop</Button>
                        </UniformGrid>
                        <TextBlock Name="ServiceRemovalNote" Margin="0,10,0,0" Foreground="#FF6B7280" FontSize="11"
                                   Text="Removing the service keeps this device registered. Device reset is separate." />
                        <Button Name="UnregisterDeviceBtn" Margin="0,10,0,0" Height="34" Click="UnregisterDevice_Click"
                                Style="{StaticResource CerberusButtonBase}">Unregister device</Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="14" Background="#FFFFFFFF" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Name="TailscaleRepairLabel" Foreground="#FF111827" FontWeight="SemiBold" Text="Tailscale" />
                        <Button Name="ExportTsBtn" Margin="0,10,0,0" Height="34" Click="ExportTs_Click"
                                Style="{StaticResource CerberusButtonBase}">Export tailscale up cmd</Button>
                        <Button Name="InstallTsBtn" Margin="0,8,0,0" Height="34" Click="InstallTs_Click"
                                Style="{StaticResource CerberusButtonBase}">Install Tailscale</Button>
                        <TextBlock Name="TsCmdPathLabel" Margin="0,10,0,0" Foreground="#FF6B7280" FontSize="11" Text="-" />
                        <TextBlock Name="TailscaleUnavailableNote" Margin="0,10,0,0" Foreground="#FF6B7280" FontSize="11"
                                   Text="If your tenant is not configured for Tailscale, export will be unavailable." />
                    </StackPanel>
                </Border>
            </Grid>
            </Expander>

            <Border CornerRadius="12" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Name="ActivityLogLabel" Foreground="#FF6B7280" FontSize="11" FontWeight="SemiBold" Text="Activity" />
                    <TextBox Name="StatusText" Margin="0,6,0,0" Background="#FFF9FAFB" Foreground="#FF111827" BorderThickness="0"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="58" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Name="AfterSetupNote" Grid.Row="2" Margin="0,14,0,0" Foreground="#FF6B7280"
                   Text="Cerberus keeps running from the Windows tray." />
    </Grid>
</Window>
