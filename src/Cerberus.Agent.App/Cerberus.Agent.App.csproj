<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cerberus.Agent.Core\Cerberus.Agent.Core.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Security\Cerberus.Agent.Security.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Observability\Cerberus.Agent.Observability.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Integrations.Tailscale\Cerberus.Agent.Integrations.Tailscale.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Integrations.Ad\Cerberus.Agent.Integrations.Ad.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cerberus.Agent</AssemblyName>
    <ApplicationIcon>..\Assets\cerberus-favicon.ico</ApplicationIcon>
    <StartupObject>Cerberus.Agent.App.Program</StartupObject>
    <AgentDefaultBackendUrlBase64 Condition="'$(AgentDefaultBackendUrlBase64)' == ''"></AgentDefaultBackendUrlBase64>
    <AgentDefaultSsoBaseUrlBase64 Condition="'$(AgentDefaultSsoBaseUrlBase64)' == ''"></AgentDefaultSsoBaseUrlBase64>
    <AgentDefaultSsoClientIdBase64 Condition="'$(AgentDefaultSsoClientIdBase64)' == ''"></AgentDefaultSsoClientIdBase64>
    <AgentDefaultSsoScopeBase64 Condition="'$(AgentDefaultSsoScopeBase64)' == ''"></AgentDefaultSsoScopeBase64>
    <AgentDefaultOAuthRedirectPort Condition="'$(AgentDefaultOAuthRedirectPort)' == ''">0</AgentDefaultOAuthRedirectPort>
    <AgentUpdateManifestPublicKeysB64 Condition="'$(AgentUpdateManifestPublicKeysB64)' == ''"></AgentUpdateManifestPublicKeysB64>
    <AgentUpdateManifestUrl Condition="'$(AgentUpdateManifestUrl)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/dev-latest/Cerberus.Agent.Bundle-dev-latest.update-manifest.v2.json</AgentUpdateManifestUrl>
    <AgentUpdateAllowedArtifactPrefixes Condition="'$(AgentUpdateAllowedArtifactPrefixes)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/</AgentUpdateAllowedArtifactPrefixes>
    <AgentReleaseChannel Condition="'$(AgentReleaseChannel)' == ''">dev</AgentReleaseChannel>
    <AgentUpdateAllowedSignerKeyIdentity Condition="'$(AgentUpdateAllowedSignerKeyIdentity)' == ''"></AgentUpdateAllowedSignerKeyIdentity>
    <AllowUnsignedDevBuild Condition="'$(AllowUnsignedDevBuild)' == ''">false</AllowUnsignedDevBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentDefaultBackendUrlBase64</_Parameter1>
      <_Parameter2>$(AgentDefaultBackendUrlBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentDefaultSsoBaseUrlBase64</_Parameter1>
      <_Parameter2>$(AgentDefaultSsoBaseUrlBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentDefaultSsoClientIdBase64</_Parameter1>
      <_Parameter2>$(AgentDefaultSsoClientIdBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentDefaultSsoScopeBase64</_Parameter1>
      <_Parameter2>$(AgentDefaultSsoScopeBase64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentDefaultOAuthRedirectPort</_Parameter1>
      <_Parameter2>$(AgentDefaultOAuthRedirectPort)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateManifestPublicKeysB64</_Parameter1>
      <_Parameter2>$(AgentUpdateManifestPublicKeysB64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateManifestUrl</_Parameter1>
      <_Parameter2>$(AgentUpdateManifestUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateAllowedArtifactPrefixes</_Parameter1>
      <_Parameter2>$(AgentUpdateAllowedArtifactPrefixes)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentReleaseChannel</_Parameter1>
      <_Parameter2>$(AgentReleaseChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateAllowedSignerKeyIdentity</_Parameter1>
      <_Parameter2>$(AgentUpdateAllowedSignerKeyIdentity)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AllowUnsignedDevBuild</_Parameter1>
      <_Parameter2>$(AllowUnsignedDevBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>


  <ItemGroup>
    <Compile Remove="SingleInstanceGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Assets\cerberus-logo.png" Link="Assets\cerberus-logo.png" />
  </ItemGroup>

</Project>
