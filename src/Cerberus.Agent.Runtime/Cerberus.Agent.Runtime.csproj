<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AgentUpdateManifestPublicKeysB64 Condition="'$(AgentUpdateManifestPublicKeysB64)' == ''"></AgentUpdateManifestPublicKeysB64>
    <AgentUpdateManifestUrl Condition="'$(AgentUpdateManifestUrl)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/dev-latest/Cerberus.Agent.Bundle-dev-latest.update-manifest.json</AgentUpdateManifestUrl>
    <AgentUpdateAllowedArtifactPrefixes Condition="'$(AgentUpdateAllowedArtifactPrefixes)' == ''">https://github.com/BUZASLAN128/cerberus-windows-agent/releases/download/</AgentUpdateAllowedArtifactPrefixes>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateManifestPublicKeysB64</_Parameter1>
      <_Parameter2>$(AgentUpdateManifestPublicKeysB64)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateManifestUrl</_Parameter1>
      <_Parameter2>$(AgentUpdateManifestUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AgentUpdateAllowedArtifactPrefixes</_Parameter1>
      <_Parameter2>$(AgentUpdateAllowedArtifactPrefixes)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="..\Cerberus.Agent.App\Actions\AgentClaimGate.cs" Link="Actions\AgentClaimGate.cs" />
    <Compile Include="..\Cerberus.Agent.App\Actions\AgentServiceProvisioning.cs" Link="Actions\AgentServiceProvisioning.cs" />
    <Compile Include="..\Cerberus.Agent.App\AgentStatus.cs" Link="AgentStatus.cs" />
    <Compile Include="..\Cerberus.Agent.App\Diagnostics\AgentDiagnosticBundleUploader.cs" Link="Diagnostics\AgentDiagnosticBundleUploader.cs" />
    <Compile Include="..\Cerberus.Agent.App\Diagnostics\AgentDiagnosticsBundle.cs" Link="Diagnostics\AgentDiagnosticsBundle.cs" />
    <Compile Include="..\Cerberus.Agent.App\Diagnostics\DiagnosticBundleCollectCommandHandler.cs" Link="Diagnostics\DiagnosticBundleCollectCommandHandler.cs" />
    <Compile Include="..\Cerberus.Agent.App\Diagnostics\DiagnosticBundleScheduler.cs" Link="Diagnostics\DiagnosticBundleScheduler.cs" />
    <Compile Include="..\Cerberus.Agent.App\Elevation.cs" Link="Elevation.cs" />
    <Compile Include="..\Cerberus.Agent.App\Legal\AgentLegalConsent.cs" Link="Legal\AgentLegalConsent.cs" />
    <Compile Include="..\Cerberus.Agent.App\Localization\AgentLocalizer.cs" Link="Localization\AgentLocalizer.cs" />
    <Compile Include="..\Cerberus.Agent.App\ProcessInstanceGuard.cs" Link="ProcessInstanceGuard.cs" />
    <Compile Include="..\Cerberus.Agent.App\ServiceInstaller.cs" Link="ServiceInstaller.cs" />
    <Compile Include="..\Cerberus.Agent.App\ServiceMode.cs" Link="ServiceMode.cs" />
    <Compile Include="..\Cerberus.Agent.App\Updates\AgentUpdateCoordinator.cs" Link="Updates\AgentUpdateCoordinator.cs" />
    <Compile Include="..\Cerberus.Agent.App\Updates\AgentUpdateDefaults.cs" Link="Updates\AgentUpdateDefaults.cs" />
    <Compile Include="..\Cerberus.Agent.App\Updates\AgentUpdateLaunchGate.cs" Link="Updates\AgentUpdateLaunchGate.cs" />
    <Compile Include="..\Cerberus.Agent.App\Updates\AgentUpdateRequestCommandHandler.cs" Link="Updates\AgentUpdateRequestCommandHandler.cs" />
    <Compile Include="..\Cerberus.Agent.App\Updates\AgentUpdateTrustFactory.cs" Link="Updates\AgentUpdateTrustFactory.cs" />
    <Compile Include="..\Cerberus.Agent.App\Updates\UpdateApplyMode.cs" Link="Updates\UpdateApplyMode.cs" />
    <Compile Include="..\Cerberus.Agent.App\WindowsDeviceInfo.cs" Link="WindowsDeviceInfo.cs" />
    <Compile Include="..\Cerberus.Agent.App\WindowsServiceHost.cs" Link="WindowsServiceHost.cs" />
    <Compile Include="..\Cerberus.Agent.App\Telemetry\**\*.cs" LinkBase="Telemetry" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Cerberus.Agent.App\Localization\AgentStrings.resx" Link="Localization\AgentStrings.resx" />
    <EmbeddedResource Include="..\Cerberus.Agent.App\Localization\AgentStrings.tr-TR.resx" Link="Localization\AgentStrings.tr-TR.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cerberus.Agent.Core\Cerberus.Agent.Core.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Integrations.Ad\Cerberus.Agent.Integrations.Ad.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Integrations.Tailscale\Cerberus.Agent.Integrations.Tailscale.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Observability\Cerberus.Agent.Observability.csproj" />
    <ProjectReference Include="..\Cerberus.Agent.Security\Cerberus.Agent.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
</Project>
