<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BackendTrustAnchors Condition="'$(BackendTrustAnchors)' == ''"></BackendTrustAnchors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BackendTrustAnchors</_Parameter1>
      <_Parameter2>$(BackendTrustAnchors)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
